pipeline {
    agent any

    options {
        timestamps()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Node.js Environment') {
            steps {
                sh 'node --version'
                sh 'npm --version'
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('node-activity-service') {
                    sh 'npm ci'
                }
            }
        }

        stage('Syntax Check') {
            steps {
                dir('node-activity-service') {
                    sh 'npm run check'
                }
            }
        }

        stage('Run Tests') {
            steps {
                dir('node-activity-service') {
                    sh 'npm test'
                }
            }
        }
    }

    post {
        success {
            echo 'PROE Node.js activity service: all checks passed!'
        }

        failure {
            echo 'Build failed. Check the Console Output for details.'
        }
    }
}