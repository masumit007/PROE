pipeline {
    agent any
    options { timestamps() }
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('Node.js checks') {
            steps {
                dir('activity-service') {
                    sh 'node --version'
                    sh 'npm --version'
                    sh 'npm ci'
                    sh 'npm run check'
                    sh 'npm test'
                }
            }
        }
        stage('Java build (if Maven project exists)') {
            steps {
                script {
                    if (fileExists('java-app/pom.xml')) {
                        dir('java-app') {
                            sh 'mvn -B -DskipTests package'
                        }
                    } else {
                        echo 'java-app/pom.xml not present yet; skipping Java build.'
                    }
                }
            }
        }
    }
    post {
        success { echo 'PROE checks completed successfully.' }
        failure { echo 'Pipeline failed. Read the first failing stage in the console log.' }
    }
}
