PORT=3000
# For local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=proe
# For Atlas, replace MONGODB_URI with your Atlas connection string.
# Do not commit your real .env file or credentials.
CORS_ORIGIN=http://localhost:8080
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Optional email demonstration. Use an app password / test SMTP account, never your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=
