# Java / Maven build output
activity-service/target/
**/target/

# Node.js dependencies
node_modules/
**/node_modules/

# Environment variables and secrets
.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# Uploaded files - keep the directory placeholder
node-activity-service/uploads/*
!node-activity-service/uploads/.gitkeep

# Generated logs
*.log
npm-debug.log*

# macOS files
.DS_Store

# IDE files
.vscode/
.idea/
# Java crash and replay logs
hs_err_pid*.log
replay_pid*.log

# Uploaded research PDFs
/uploads/*
!/uploads/.gitkeep

# Express API uploads and Vite cache
mysql-api/uploads/*
!mysql-api/uploads/.gitkeep
.vite/
